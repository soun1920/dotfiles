#!/usr/bin/env bash

set -u

exec rofi \
    -show combi \
    -modes combi \
    -combi-modes "palette:${HOME}/.local/bin/rofi-palette,drun" \
    -display-combi "Run" \
    -display-drun "" \
    -display-palette "" \
    -show-icons \
    -matching fuzzy \
    -sort \
    -sorting-method fzf \
    -p "Run"
