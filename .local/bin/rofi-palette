#!/usr/bin/env bash

set -u

readonly SEP=$'\x1f'

open_web_search() {
    local query=$1 encoded
    encoded=$(jq -rn --arg query "$query" '$query | @uri')
    setsid -f xdg-open "https://www.google.com/search?q=${encoded}" >/dev/null 2>&1
}

open_bookmark() {
    local initial=${1:-} bookmarks_file selection url
    local -a bookmark_files=()

    while IFS= read -r bookmarks_file; do
        bookmark_files+=("$bookmarks_file")
    done < <(find "${HOME}/.config" -type f -name Bookmarks -path '*/Default/*' 2>/dev/null)

    if ((${#bookmark_files[@]} == 0)); then
        notify-send "Rofi" "Chromium系ブラウザのブックマークが見つかりません"
        return
    fi

    selection=$(
        jq -r '
            .. | objects
            | select(.type? == "url")
            | [.name, .url]
            | @tsv
        ' "${bookmark_files[@]}" 2>/dev/null \
            | sort -u \
            | rofi -dmenu -i -matching fuzzy -filter "$initial" -p "Bookmark"
    ) || return

    url=${selection#*$'\t'}
    [[ -n $url ]] && setsid -f xdg-open "$url" >/dev/null 2>&1
}

focus_window() {
    local initial=${1:-} selection id
    selection=$(
        niri msg --json windows \
            | jq -r '.[] | [(.title // "(untitled)"), .app_id, (.workspace_id | tostring), (.id | tostring)] | @tsv' \
            | rofi -dmenu -i -matching fuzzy -filter "$initial" -p "Window"
    ) || return

    id=${selection##*$'\t'}
    [[ $id =~ ^[0-9]+$ ]] && niri msg action focus-window --id "$id" >/dev/null
}

open_clipboard() {
    local initial=${1:-} selection

    if command -v cliphist >/dev/null 2>&1; then
        selection=$(cliphist list | rofi -dmenu -i -matching fuzzy -filter "$initial" -p "Clipboard") || return
        [[ -n $selection ]] && cliphist decode <<<"$selection" | wl-copy
    else
        dms ipc call clipboard toggle >/dev/null 2>&1
        notify-send "Rofi" "cliphist未導入のためDMS Clipboardを開きました"
    fi
}

run_command() {
    local input=$1

    case "$input" in
        web\ *) open_web_search "${input#web }" ;;
        web)    open_web_search "$(rofi -dmenu -p 'Google')" ;;
        win\ *) focus_window "${input#win }" ;;
        win)    focus_window ;;
        bm\ *)  open_bookmark "${input#bm }" ;;
        bm)     open_bookmark ;;
        clip\ *) open_clipboard "${input#clip }" ;;
        clip)    open_clipboard ;;
        pw\ *|pw) setsid -f 1password --quick-access >/dev/null 2>&1 ;;
    esac
}

case "${ROFI_RETV:-0}" in
    0)
        printf 'web  Google検索\0icon%sweb-browser%sinfo%scmd:web\n' "$SEP" "$SEP" "$SEP"
        printf 'win  ウィンドウ切り替え\0icon%sfocus-windows%sinfo%scmd:win\n' "$SEP" "$SEP" "$SEP"
        printf 'bm   ブックマーク\0icon%sbookmark-new%sinfo%scmd:bm\n' "$SEP" "$SEP" "$SEP"
        printf 'clip クリップボード\0icon%sedit-paste%sinfo%scmd:clip\n' "$SEP" "$SEP" "$SEP"
        printf 'pw   1Password Quick Access\0icon%s1password%sinfo%scmd:pw\n' "$SEP" "$SEP" "$SEP"
        ;;
    1)
        case "${ROFI_INFO:-}" in
            cmd:*) run_command "${ROFI_INFO#cmd:}" ;;
            *)     run_command "${1:-}" ;;
        esac
        ;;
esac
