# Font Configuration
font-size = 15

# Window Configuration
window-decoration = false
window-padding-x = 12
window-padding-y = 12

# Theme (Iceberg Dark)
theme = Iceberg Dark
background = #161821
# background-image = /home/aw5qm/.config/wezterm/images/wallpaper.jpg
background-image-opacity = 0.15
foreground = #c6c8d1
selection-background = #c6c8d1
selection-foreground = #161821
cursor-color = #c6c8d1
cursor-text = #161821
palette = 0=#1e2132
palette = 1=#e27878
palette = 2=#b4be82
palette = 3=#e2a478
palette = 4=#84a0c6
palette = 5=#a093c7
palette = 6=#89b8c2
palette = 7=#c6c8d1
palette = 8=#6b7089
palette = 9=#e98989
palette = 10=#c0ca8e
palette = 11=#e9b189
palette = 12=#91acd1
palette = 13=#ada0d3
palette = 14=#95c4ce
palette = 15=#d2d4de

# Cursor Configuration
cursor-style = bar
cursor-style-blink = true

# Scrollback
scrollback-limit = 3023

# Terminal features
mouse-hide-while-typing = true
copy-on-select = false
confirm-close-surface = false

# Disable in-app Ghostty toast notifications
app-notifications = false

# Key bindings for common actions
keybind = ctrl+shift+n=new_window
keybind = ctrl+t=new_tab
keybind = ctrl+plus=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+zero=reset_font_size
keybind = shift+enter=text:\n

# Tab configuration
gtk-titlebar = false
gtk-single-instance = true

# Shell integration
shell-integration = detect
shell-integration-features = cursor,sudo,title,no-cursor
