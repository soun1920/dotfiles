#!/usr/bin/env bash
set -euo pipefail

echo "==> yadm bootstrap start"

# パッケージインストール（mise管理のもの・GUIアプリは除く）
PACKAGES_COMMON=(
  git curl fish
)
PACKAGES_FEDORA=(
  "${PACKAGES_COMMON[@]}"
  wl-clipboard gcc make
)
PACKAGES_UBUNTU=(
  "${PACKAGES_COMMON[@]}"
  wl-clipboard build-essential
)
PACKAGES_DARWIN=(
  "${PACKAGES_COMMON[@]}"
)

if [[ "$(uname)" == "Darwin" ]]; then
  if ! command -v brew &>/dev/null; then
    echo "==> Installing Homebrew..."
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    # Apple Silicon
    if [[ -f /opt/homebrew/bin/brew ]]; then
      eval "$(/opt/homebrew/bin/brew shellenv)"
    fi
  fi
  echo "==> Installing packages via brew..."
  brew install "${PACKAGES_DARWIN[@]}"
elif command -v dnf &>/dev/null; then
  echo "==> Installing packages via dnf..."
  sudo dnf install -y "${PACKAGES_FEDORA[@]}"
elif command -v apt &>/dev/null; then
  echo "==> Installing packages via apt..."
  sudo apt update
  sudo apt install -y "${PACKAGES_UBUNTU[@]}"
fi

# mise
if ! command -v mise &>/dev/null; then
  echo "==> Installing mise..."
  curl https://mise.run | sh
  export PATH="$HOME/.local/bin:$PATH"
fi

echo "==> Installing mise tools..."
mise install

# fish をデフォルトシェルに設定
FISH_PATH="$(which fish 2>/dev/null || echo "")"
if [[ -n "$FISH_PATH" ]] && [[ "$SHELL" != "$FISH_PATH" ]]; then
  echo "==> Setting fish as default shell..."
  if ! grep -qF "$FISH_PATH" /etc/shells; then
    echo "$FISH_PATH" | sudo tee -a /etc/shells
  fi
  chsh -s "$FISH_PATH"
fi

# cargo install (mise管理不可のもの)
echo "==> Installing cargo packages..."
cargo install --git https://github.com/rtk-ai/rtk

# uv tools
echo "==> Installing uv tools..."
uv tool install atcoder-tools
uv tool install wandbox-api
uv tool install claude-conversation-extractor

# pnpm global packages
echo "==> Installing pnpm global packages..."
pnpm install -g atcoder-cli

# fisher + fish プラグイン
if command -v fish &>/dev/null; then
  echo "==> Installing fisher and fish plugins..."
  fish -c "
    if not functions -q fisher
      curl -sL https://raw.githubusercontent.com/jorgebucaran/fisher/main/functions/fisher.fish | source
      fisher install jorgebucaran/fisher
    end
    fisher update
  "
fi

echo "==> Bootstrap complete!"
