// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "terminal": {
    "font_size": 12.0
  },
  "reduce_motion": "on",
  "cli_default_open_behavior": "existing_window",
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "languages": {
    "C++": {
      "show_edit_predictions": false
    }
  },
  "agent_servers": {
    "codex-acp": {
      "default_config_options": {
        "fast-mode": false,
        "reasoning_effort": "medium"
      },
      "type": "registry"
    },
    "opencode": {
      "type": "registry"
    },
    "claude-acp": {
      "favorite_config_option_values": {
        "mode": [
          "plan"
        ]
      },
      "type": "registry"
    },
    "github-copilot": {
      "type": "registry"
    }
  },
  "agent": {
    "sandbox_permissions": {
      "allow_unsandboxed": true
    },
    "dock": "right",
    "default_model": {
      "effort": "high",
      "provider": "openai-subscribed",
      "model": "gpt-5.6-sol",
      "enable_thinking": true
    },
    "favorite_models": [],
    "model_parameters": []
  },
  "edit_predictions": {
    "provider": "copilot"
  },
  "git_panel": {
    "dock": "left",
    "tree_view": false
  },
  "ssh_connections": [
    {
      "host": "orangepi5",
      "username": "orangepi",
      "args": [],
      "projects": [
        {
          "paths": [
            "/home/orangepi"
          ]
        }
      ]
    },
    {
      "host": "orangepi5-3",
      "username": "krp",
      "args": [],
      "projects": [
        {
          "paths": [
            "/home/krp"
          ]
        },
        {
          "paths": [
            "/home/krp/test/belt/./"
          ]
        },
        {
          "paths": [
            "/home/krp/test/bno055/./"
          ]
        },
        {
          "paths": [
            "/home/krp/test/display"
          ]
        },
        {
          "paths": [
            "/home/krp/test/st7789-display/./"
          ]
        },
        {
          "paths": [
            "/home/krp/yolo-test/./"
          ]
        }
      ]
    }
  ],
  "buffer_font_family": "PlemolJP Console NF",
  "show_edit_predictions": true,
  "icon_theme": {
    "mode": "light",
    "light": "Catppuccin Macchiato",
    "dark": "Catppuccin Macchiato"
  },
  "ui_font_size": 16,
  "vim_mode": true,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "Catppuccin Latte - No Italics",
    "dark": "Ayu Mirage",
  },
  "inlay_hints": {
    "enabled": true,
    "show_type_hints": true,
    "show_parameter_hints": true,
    "show_other_hints": true,
    "edit_debounce_ms": 700,
    "scroll_debounce_ms": 50,
  },  "experimental.theme_overrides": {

  }
}
