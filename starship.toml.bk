# Warning: This config does not include keys that have an unset value

# $all is shorthand for $username$hostname$localip$shlvl$singularity$kubernetes$nats$directory$vcsh$fossil_branch$fossil_metrics$git_branch$git_commit$git_state$git_metrics$git_status$hg_branch$pijul_channel$docker_context$package$bun$c$cmake$cobol$daml$dart$deno$dotnet$elixir$elm$erlang$fennel$gleam$golang$gradle$haskell$haxe$helm$java$julia$kotlin$lua$mojo$nim$nodejs$ocaml$odin$opa$perl$php$pulumi$purescript$python$quarto$raku$rlang$red$ruby$rust$scala$solidity$swift$terraform$typst$vlang$vagrant$zig$buf$guix_shell$nix_shell$conda$meson$spack$memory_usage$aws$gcloud$openstack$azure$direnv$env_var$crystal$custom$sudo$cmd_duration$line_break$jobs$battery$time$status$container$os$shell$character
"$schema" = "https://starship.rs/config-schema.json"

[palettes.iceberg]
fg = "#c6c8d1"
# bg = "#161821" # Terminal background is usually set by the terminal emulator itself
blue = "#7490c0"
cyan = "#55b5db"
green = "#8cc85f"
magenta = "#e29eca"
red = "#da7070"
yellow = "#f5c06f"
orange = "#f0a055"
gray = "#6b7089" # Used for comments, less prominent elements
comment = "gray" # Alias

# Warning: This config does not include keys that have an unset value
# $all is shorthand for $username$hostname$localip$shlvl$singularity$kubernetes$nats$directory$vcsh$fossil_branch$fossil_metrics$git_branch$git_commit$git_state$git_metrics$git_status$hg_branch$pijul_channel$docker_context$package$bun$c$cmake$cobol$daml$dart$deno$dotnet$elixir$elm$erlang$fennel$gleam$golang$gradle$haskell$haxe$helm$java$julia$kotlin$lua$mojo$nim$nodejs$ocaml$odin$opa$perl$php$pulumi$purescript$python$quarto$raku$rlang$red$ruby$rust$scala$solidity$swift$terraform$typst$vlang$vagrant$zig$buf$guix_shell$nix_shell$conda$meson$spack$memory_usage$aws$gcloud$openstack$azure$direnv$env_var$crystal$custom$sudo$cmd_duration$line_break$jobs$battery$time$status$container$os$shell$character
"$schema" = "https://starship.rs/config-schema.json"

# Root-level primitive value settings
scan_timeout = 30
command_timeout = 500
add_newline = true
follow_symlinks = true

# Palettes definition
[palettes.iceberg]
fg = "#c6c8d1"
# bg = "#161821" # Terminal background is usually set by the terminal emulator itself
blue = "#7490c0"
cyan = "#55b5db"
green = "#8cc85f"
magenta = "#e29eca"
red = "#da7070"
yellow = "#f5c06f"
orange = "#f0a055"
gray = "#6b7089" # Used for comments, less prominent elements
comment = "gray" # Alias

# Semantic aliases
error = "red"
success = "green"
warning = "yellow"
info = "blue"
accent1 = "cyan"
accent2 = "magenta"
accent3 = "orange"

# Root-level format strings that might use palettes
format = "$all"
right_format = ""
continuation_prompt = "[∙]($iceberg.gray) " # Was bright-black, now uses palette

# MODULE CONFIGURATIONS START HERE
[aws]
format = 'on [$symbol($profile )(\($region\) )(\[$duration\] )]($style)'
symbol = "☁️  "
style = "bold $iceberg.yellow" # Was bold yellow
disabled = false
expiration_symbol = "X"
force_display = false

[aws.region_aliases]

[aws.profile_aliases]

[azure]
format = "on [$symbol($subscription)]($style) "
symbol = "󰠅 "
style = "bold $iceberg.blue" # Was blue bold
disabled = true

[azure.subscription_aliases]

[battery]
full_symbol = "󰁹 "
charging_symbol = "󰂄 "
discharging_symbol = "󰂃 "
unknown_symbol = "󰁽 "
empty_symbol = "󰂎 "
disabled = false
format = "[$symbol$percentage]($style) "

[[battery.display]]
threshold = 10
style = "bold $iceberg.red" # Was red bold

[buf]
format = "with [$symbol($version )]($style)"
version_format = "v${raw}"
symbol = "🐃 "
style = "bold $iceberg.blue" # Was bold blue
disabled = false
detect_extensions = []
detect_files = ["buf.yaml", "buf.gen.yaml", "buf.work.yaml"]
detect_folders = []

[bun]
format = "via [$symbol($version )]($style)"
version_format = "v${raw}"
symbol = "🥟 "
style = "bold $iceberg.red" # Was bold red
disabled = false
detect_extensions = []
detect_files = ["bun.lockb", "bunfig.toml"]
detect_folders = []

[c]
format = "via [$symbol($version(-$name) )]($style)"
version_format = "v${raw}"
style = "bold $iceberg.magenta" # Was 149 bold (light purple/pink)
symbol = "C "
disabled = false
detect_extensions = ["c", "h"]
detect_files = []
detect_folders = []
commands = [["cc", "--version"], ["gcc", "--version"], ["clang", "--version"]]

[character]
format = "$symbol "
success_symbol = "[❯](bold $iceberg.green)" # Was bold green
error_symbol = "[❯](bold $iceberg.red)" # Was bold red
vimcmd_symbol = "[❮](bold $iceberg.green)" # Was bold green
vimcmd_visual_symbol = "[❮](bold $iceberg.yellow)" # Was bold yellow
vimcmd_replace_symbol = "[❮](bold $iceberg.magenta)" # Was bold purple
vimcmd_replace_one_symbol = "[❮](bold $iceberg.magenta)" # Was bold purple
disabled = false

[cmake]
format = "via [$symbol($version )]($style)"
version_format = "v${raw}"
symbol = "△ "
style = "bold $iceberg.blue" # Was bold blue
disabled = false
detect_extensions = []
detect_files = ["CMakeLists.txt", "CMakeCache.txt"]
detect_folders = []

[cmd_duration]
min_time = 2000
format = "took [$duration]($style) "
style = "bold $iceberg.yellow" # Was yellow bold
show_milliseconds = false
disabled = false
show_notifications = false
min_time_to_notify = 45000

[cobol]
format = "via [$symbol($version )]($style)"
version_format = "v${raw}"
symbol = "⚙️ "
style = "bold $iceberg.blue" # Was bold blue
disabled = false
detect_extensions = ["cbl", "cob", "CBL", "COB"]
detect_files = []
detect_folders = []

[conda]
truncation_length = 1
format = "via [$symbol$environment]($style) "
symbol = "🅒 "
style = "bold $iceberg.green" # Was green bold
ignore_base = true
disabled = false

[container]
format = '[$symbol \[$name\]]($style) '
symbol = "⬢"
style = "dimmed $iceberg.red bold" # Was red bold dimmed
disabled = false

[crystal]
format = "via [$symbol($version )]($style)"
version_format = "v${raw}"
symbol = "🔮 "
style = "bold $iceberg.red" # Was bold red
disabled = false
detect_extensions = ["cr"]
detect_files = ["shard.yml"]
detect_folders = []

[daml]
symbol = "Λ "
format = "via [$symbol($version )]($style)"
version_format = "v${raw}"
style = "bold $iceberg.cyan" # Was bold cyan
disabled = false
detect_extensions = []
detect_files = ["daml.yaml"]
detect_folders = []

[dart]
format = "via [$symbol($version )]($style)"
version_format = "v${raw}"
symbol = "🎯 "
style = "bold $iceberg.blue" # Was bold blue
disabled = false
detect_extensions = ["dart"]
detect_files = ["pubspec.yaml", "pubspec.yml", "pubspec.lock"]
detect_folders = [".dart_tool"]

[deno]
format = "via [$symbol($version )]($style)"
version_format = "v${raw}"
symbol = "🦕 "
style = "bold $iceberg.green" # Was green bold
disabled = false
detect_extensions = []
detect_files = [
    "deno.json",
    "deno.jsonc",
    "deno.lock",
    "mod.ts",
    "deps.ts",
    "mod.js",
    "deps.js",
]
detect_folders = []

[directory]
truncation_length = 3
truncate_to_repo = true
fish_style_pwd_dir_length = 0
use_logical_path = true
format = "[$path]($style)[$read_only]($read_only_style) "
repo_root_format = "[$before_root_path]($before_repo_root_style)[$repo_root]($repo_root_style)[$path]($style)[$read_only]($read_only_style) "
style = "bold $iceberg.cyan" # Was cyan bold
disabled = false
read_only = "🔒"
read_only_style = "$iceberg.red" # Was red
truncation_symbol = ""
home_symbol = "~"
use_os_path_sep = true
# Example for repo_root_style if you want to differentiate it
# before_repo_root_style = "bold $iceberg.gray"
# repo_root_style = "bold $iceberg.blue"


[directory.substitutions]

[direnv]
format = "[$symbol$loaded/$allowed]($style) "
symbol = "direnv "
style = "bold $iceberg.yellow" # Was bold bright-yellow
disabled = true
detect_extensions = []
detect_files = [".envrc"]
detect_folders = []
allowed_msg = "allowed"
not_allowed_msg = "not allowed"
denied_msg = "denied"
loaded_msg = "loaded"
unloaded_msg = "not loaded"

[docker_context]
symbol = "🐳 "
style = "bold $iceberg.blue" # Was blue bold
format = "via [$symbol$context]($style) "
only_with_files = true
disabled = false
detect_extensions = []
detect_files = ["docker-compose.yml", "docker-compose.yaml", "Dockerfile"]
detect_folders = []

[dotnet]
format = "via [$symbol($version )(🎯 $tfm )]($style)"
version_format = "v${raw}"
symbol = ".NET "
style = "bold $iceberg.blue" # Was blue bold
heuristic = true
disabled = false
detect_extensions = ["csproj", "fsproj", "xproj"]
detect_files = [
    "global.json",
    "project.json",
    "Directory.Build.props",
    "Directory.Build.targets",
    "Packages.props",
]
detect_folders = []

[elixir]
format = 'via [$symbol($version \(OTP $otp_version\) )]($style)'
version_format = "v${raw}"
symbol = "💧 "
style = "bold $iceberg.magenta" # Was bold purple
disabled = false
detect_extensions = []
detect_files = ["mix.exs"]
detect_folders = []

[elm]
format = "via [$symbol($version )]($style)"
version_format = "v${raw}"
symbol = "🌳 "
style = "bold $iceberg.cyan" # Was cyan bold
disabled = false
detect_extensions = ["elm"]
detect_files = ["elm.json", "elm-package.json", ".elm-version"]
detect_folders = ["elm-stuff"]

[env_var]

[erlang]
format = "via [$symbol($version )]($style)"
version_format = "v${raw}"
symbol = " "
style = "bold $iceberg.red" # Was bold red
disabled = false
detect_extensions = []
detect_files = ["rebar.config", "erlang.mk"]
detect_folders = []

[fennel]
format = "via [$symbol($version )]($style)"
version_format = "v${raw}"
symbol = "🧅 "
style = "bold $iceberg.green" # Was bold green
disabled = true
detect_extensions = ["fnl"]
detect_files = []
detect_folders = []

[fill]
style = "bold $iceberg.gray" # Was bold black, changed to a less intrusive Iceberg color
symbol = "."
disabled = false

[fossil_branch]
format = "on [$symbol$branch]($style) "
symbol = " "
style = "bold $iceberg.magenta" # Was bold purple
truncation_length = 9223372036854775807
truncation_symbol = "…"
disabled = true

[fossil_metrics]
format = "([+$added]($added_style) )([-$deleted]($deleted_style) )"
added_style = "bold $iceberg.green" # Was bold green
deleted_style = "bold $iceberg.red" # Was bold red
only_nonzero_diffs = true
disabled = true

[gcloud]
format = 'on [$symbol$account(@$domain)(\($region\))]($style) '
symbol = "☁️  "
style = "bold $iceberg.blue" # Was bold blue
disabled = false
detect_env_vars = []

[gcloud.region_aliases]

[gcloud.project_aliases]

[git_branch]
format = "on [$symbol$branch(:$remote_branch)]($style) "
symbol = " "
style = "bold $iceberg.magenta" # Was bold purple
truncation_length = 9223372036854775807
truncation_symbol = "…"
only_attached = false
always_show_remote = false
ignore_branches = []
disabled = false

[git_commit]
commit_hash_length = 7
format = '[\($hash$tag\)]($style) '
style = "bold $iceberg.green" # Was green bold
only_detached = true
disabled = false
tag_symbol = " 🏷  "
tag_disabled = true
tag_max_candidates = 0

[git_metrics]
added_style = "bold $iceberg.green" # Was bold green
deleted_style = "bold $iceberg.red" # Was bold red
only_nonzero_diffs = true
format = "([+$added]($added_style) )([-$deleted]($deleted_style) )"
disabled = true
ignore_submodules = false

[git_state]
rebase = "REBASING"
merge = "MERGING"
revert = "REVERTING"
cherry_pick = "CHERRY-PICKING"
bisect = "BISECTING"
am = "AM"
am_or_rebase = "AM/REBASE"
style = "bold $iceberg.yellow" # Was bold yellow
format = '\([$state( $progress_current/$progress_total)]($style)\) '
disabled = false

[git_status]
format = '([\[$all_status$ahead_behind\]]($style) )'
style = "bold $iceberg.orange" # Was red bold, changed to orange for less alarm, or use $iceberg.red if preferred
stashed = '\$'
ahead = "⇡"
behind = "⇣"
up_to_date = ""
diverged = "⇕"
conflicted = "="
deleted = "✘"
renamed = "»"
modified = "!"
staged = "+"
untracked = "?"
typechanged = ""
ignore_submodules = false
disabled = false

[gleam]
format = "via [$symbol($version )]($style)"
version_format = "v${raw}"
symbol = "⭐ "
style = "bold $iceberg.magenta" # Was bold #FFAFF3 (light pink)
disabled = false
detect_extensions = ["gleam"]
detect_files = ["gleam.toml"]
detect_folders = []

[golang]
format = "via [$symbol($version )]($style)"
version_format = "v${raw}"
symbol = "🐹 "
style = "bold $iceberg.cyan" # Was bold cyan
disabled = false
not_capable_style = "bold $iceberg.red" # Was bold red
detect_extensions = ["go"]
detect_files = [
    "go.mod",
    "go.sum",
    "go.work",
    "glide.yaml",
    "Gopkg.yml",
    "Gopkg.lock",
    ".go-version",
]
detect_folders = ["Godeps"]

[gradle]
format = "via [$symbol($version )]($style)"
version_format = "v${raw}"
symbol = "🅶 "
style = "bold $iceberg.cyan" # Was bold bright-cyan
disabled = false
recursive = false
detect_extensions = ["gradle", "gradle.kts"]
detect_files = []
detect_folders = ["gradle"]

[guix_shell]
format = "via [$symbol]($style) "
symbol = "🐃 "
style = "bold $iceberg.yellow" # Was yellow bold
disabled = false

[haskell]
format = "via [$symbol($version )]($style)"
version_format = "v${raw}"
symbol = "λ "
style = "bold $iceberg.magenta" # Was bold purple
disabled = false
detect_extensions = ["hs", "cabal", "hs-boot"]
detect_files = ["stack.yaml", "cabal.project"]
detect_folders = []

[haxe]
format = "via [$symbol($version )]($style)"
version_format = "v${raw}"
symbol = "⌘ "
style = "bold $iceberg.orange" # Was bold fg:202 (orange-pink)
disabled = false
detect_extensions = ["hx", "hxml"]
detect_files = ["haxelib.json", "hxformat.json", ".haxerc"]
detect_folders = [".haxelib", "haxe_libraries"]

[helm]
format = "via [$symbol($version )]($style)"
version_format = "v${raw}"
symbol = "⎈ "
style = "bold $iceberg.fg" # Was bold white
disabled = false
detect_extensions = []
detect_files = ["helmfile.yaml", "Chart.yaml"]
detect_folders = []

[hg_branch]
symbol = " "
style = "bold $iceberg.magenta" # Was bold purple
format = "on [$symbol$branch(:$topic)]($style) "
truncation_length = 9223372036854775807
truncation_symbol = "…"
disabled = true

[hostname]
ssh_only = true
ssh_symbol = "🌐 "
trim_at = "."
detect_env_vars = []
format = "[$ssh_symbol$hostname]($style) in "
style = "bold dimmed $iceberg.green" # Was green dimmed bold
disabled = false

[hostname.aliases]

[java]
disabled = false
format = "via [$symbol($version )]($style)"
version_format = "v${raw}"
style = "dimmed $iceberg.orange" # Was red dimmed, changed to less alarming orange
symbol = "☕ "
detect_extensions = ["java", "class", "jar", "gradle", "clj", "cljc"]
detect_files = [
    "pom.xml",
    "build.gradle.kts",
    "build.sbt",
    ".java-version",
    "deps.edn",
    "project.clj",
    "build.boot",
    ".sdkmanrc",
]
detect_folders = []

[jobs]
threshold = 1
symbol_threshold = 1
number_threshold = 2
format = "[$symbol$number]($style) "
symbol = "✦"
style = "bold $iceberg.blue" # Was bold blue
disabled = false

[julia]
format = "via [$symbol($version )]($style)"
version_format = "v${raw}"
symbol = "ஃ "
style = "bold $iceberg.magenta" # Was bold purple
disabled = false
detect_extensions = ["jl"]
detect_files = ["Project.toml", "Manifest.toml"]
detect_folders = []

[kotlin]
format = "via [$symbol($version )]($style)"
version_format = "v${raw}"
symbol = "🅺 "
style = "bold $iceberg.blue" # Was bold blue
kotlin_binary = "kotlin"
disabled = false
detect_extensions = ["kt", "kts"]
detect_files = []
detect_folders = []

[kubernetes]
symbol = "☸ "
format = '[$symbol$context( \($namespace\))]($style) in '
style = "bold $iceberg.cyan" # Was cyan bold
disabled = true
detect_extensions = []
detect_files = []
detect_folders = []
detect_env_vars = []
contexts = []

[kubernetes.context_aliases]

[kubernetes.user_aliases]

[line_break]
disabled = false

[localip]
ssh_only = true
format = "[$localipv4]($style) "
style = "bold $iceberg.yellow" # Was yellow bold
disabled = true

[lua]
format = "via [$symbol($version )]($style)"
version_format = "v${raw}"
symbol = "🌙 "
style = "bold $iceberg.blue" # Was bold blue
lua_binary = "lua"
disabled = false
detect_extensions = ["lua"]
detect_files = [".lua-version"]
detect_folders = ["lua"]

[memory_usage]
threshold = 75
format = "via $symbol[$ram( | $swap)]($style) "
style = "bold dimmed $iceberg.fg" # Was white bold dimmed
symbol = "🐏 "
disabled = true

[meson]
truncation_length = 4294967295
truncation_symbol = "…"
format = "via [$symbol$project]($style) "
symbol = "⬢ "
style = "bold $iceberg.blue" # Was blue bold
disabled = false

[mojo]
format = "with [$symbol($version )]($style)"
symbol = "🔥 "
style = "bold $iceberg.orange" # Was bold 208 (orange)
disabled = false
detect_extensions = ["mojo", "🔥"]
detect_files = []
detect_folders = []

[nats]
format = "[$symbol($name )]($style)"
symbol = "✉️ "
style = "bold $iceberg.magenta" # Was bold purple
disabled = true

[nim]
format = "via [$symbol($version )]($style)"
version_format = "v${raw}"
symbol = "👑 "
style = "bold $iceberg.yellow" # Was yellow bold
disabled = false
detect_extensions = ["nim", "nims", "nimble"]
detect_files = ["nim.cfg"]
detect_folders = []

[nix_shell]
format = 'via [$symbol$state( \($name\))]($style) '
symbol = "❄️  "
style = "bold $iceberg.blue" # Was bold blue
impure_msg = "impure"
pure_msg = "pure"
unknown_msg = ""
disabled = false
heuristic = false

[nodejs]
format = "via [$symbol($version )]($style)"
version_format = "v${raw}"
symbol = " "
style = "bold $iceberg.green" # Was bold green
disabled = false
not_capable_style = "bold $iceberg.red" # Was bold red
detect_extensions = ["js", "mjs", "cjs", "ts", "mts", "cts"]
detect_files = ["package.json", ".node-version", ".nvmrc"]
detect_folders = ["node_modules"]

[ocaml]
format = 'via [$symbol($version )(\($switch_indicator$switch_name\) )]($style)'
version_format = "v${raw}"
global_switch_indicator = ""
local_switch_indicator = "*"
symbol = "🐫 "
style = "bold $iceberg.yellow" # Was bold yellow
disabled = false
detect_extensions = ["opam", "ml", "mli", "re", "rei"]
detect_files = ["dune", "dune-project", "jbuild", "jbuild-ignore", ".merlin"]
detect_folders = ["_opam", "esy.lock"]

[odin]
format = "via [$symbol($version )]($style)"
show_commit = false
symbol = "Ø "
style = "bold $iceberg.blue" # Was bold bright-blue
disabled = false
detect_extensions = ["odin"]
detect_files = []
detect_folders = []

[opa]
format = "via [$symbol($version )]($style)"
version_format = "v${raw}"
symbol = "🪖  "
style = "bold $iceberg.blue" # Was bold blue
disabled = false
detect_extensions = ["rego"]
detect_files = []
detect_folders = []

[openstack]
format = 'on [$symbol$cloud(\($project\))]($style) '
symbol = "☁️  "
style = "bold $iceberg.yellow" # Was bold yellow
disabled = false

[os]
format = "[$symbol]($style)"
style = "bold $iceberg.fg" # Was bold white
disabled = true

[os.symbols]
AIX = "➿ "
Alpaquita = "🔔 "
