version_format = "v${raw}"

[perl]
format = "via [$symbol($version )]($style)"
version_format = "v${raw}"
symbol = "🐪 "
style = "bold $iceberg.magenta" # Was 149 bold (light purple/pink)
disabled = false
detect_extensions = ["pl", "pm", "pod"]
