[php]
format = "via [$symbol($version )]($style)"
version_format = "v${raw}"
symbol = "🐘 "
style = "bold $iceberg.magenta" # Was 147 bold (light blue-purple)
disabled = false
detect_extensions = ["php"]
detect_files = ["composer.json", ".php-version"]
detect_folders = []

[pijul_channel]
symbol = " "
style = "bold $iceberg.magenta" # Was bold purple
format = "on [$symbol$channel]($style) "
truncation_length = 9223372036854775807
truncation_symbol = "…"
disabled = true

[pulumi]
format = "via [$symbol($username@)$stack]($style) "
version_format = "v${raw}"
symbol = " "
style = "bold $iceberg.magenta" # Was bold 5 (magenta)
disabled = false
search_upwards = true

[purescript]
format = "via [$symbol($version )]($style)"
version_format = "v${raw}"
symbol = "<=> "
style = "bold $iceberg.fg" # Was bold white
disabled = false
detect_extensions = ["purs"]
detect_files = ["spago.dhall", "spago.yaml", "spago.lock"]
detect_folders = []

[python]
pyenv_version_name = false
pyenv_prefix = "pyenv "
python_binary = ["python", "python3", "python2"]
format = 'via [${symbol}${pyenv_prefix}(${version} )(\($virtualenv\) )]($style)'
version_format = "v${raw}"
style = "bold $iceberg.yellow" # Was yellow bold
symbol = "🐍 "
disabled = false
detect_extensions = ["py", "ipynb"]
detect_files = [
    "requirements.txt",
    ".python-version",
    "pyproject.toml",
    "Pipfile",
    "tox.ini",
    "setup.py",
    "__init__.py",
    "pixi.toml",
]
detect_folders = []
detect_env_vars = ["VIRTUAL_ENV"]

[quarto]
format = "via [$symbol($version )]($style)"
version_format = "v${raw}"
symbol = "⨁ "
style = "bold $iceberg.blue" # Was bold #75AADB (blue)
disabled = false
detect_extensions = ["qmd"]
detect_files = ["_quarto.yml"]
detect_folders = []

[raku]
format = "via [$symbol($version-$vm_version )]($style)"
version_format = "${raw}"
symbol = "🦋 "
style = "bold $iceberg.magenta" # Was 149 bold (light purple/pink)
disabled = false
detect_extensions = ["p6", "pm6", "pod6", "raku", "rakumod"]
detect_files = ["META6.json"]
detect_folders = []

[red]
format = "via [$symbol($version )]($style)"
version_format = "v${raw}"
symbol = "🔺 "
style = "bold $iceberg.red" # Was red bold
disabled = false
detect_extensions = ["red", "reds"]
detect_files = []
detect_folders = []

[rlang]
format = "via [$symbol($version )]($style)"
version_format = "v${raw}"
style = "bold $iceberg.blue" # Was blue bold
symbol = "📐 "
disabled = false
detect_extensions = ["R", "Rd", "Rmd", "Rproj", "Rsx"]
detect_files = ["DESCRIPTION"]
detect_folders = [".Rproj.user"]

[ruby]
format = "via [$symbol($version )]($style)"
version_format = "v${raw}"
symbol = "💎 "
style = "bold $iceberg.red" # Was bold red
disabled = false
detect_extensions = ["rb"]
detect_files = ["Gemfile", ".ruby-version"]
detect_folders = []
detect_variables = ["RUBY_VERSION", "RBENV_VERSION"]

[rust]
format = "via [$symbol($version )]($style)"
version_format = "v${raw}"
symbol = "🦀 "
style = "bold $iceberg.orange" # Was bold red, changed to orange for variation
disabled = false
detect_extensions = ["rs"]
detect_files = ["Cargo.toml"]
detect_folders = []

[scala]
format = "via [$symbol($version )]($style)"
version_format = "v${raw}"
disabled = false
style = "bold $iceberg.red" # Was red bold
symbol = "🆂 "
detect_extensions = ["sbt", "scala"]
detect_files = [".scalaenv", ".sbtenv", "build.sbt"]
detect_folders = [".metals"]

[shell]
format = "[$indicator]($style) "
bash_indicator = "bsh"
fish_indicator = "fsh"
zsh_indicator = "zsh"
powershell_indicator = "psh"
ion_indicator = "ion"
elvish_indicator = "esh"
tcsh_indicator = "tsh"
nu_indicator = "nu"
xonsh_indicator = "xsh"
cmd_indicator = "cmd"
unknown_indicator = ""
style = "bold $iceberg.fg" # Was white bold
disabled = true

[shlvl]
threshold = 2
format = "[$symbol$shlvl]($style) "
symbol = "↕️  "
repeat = false
repeat_offset = 0
style = "bold $iceberg.yellow" # Was bold yellow
disabled = true

[singularity]
symbol = ""
format = '[$symbol\[$env\]]($style) '
style = "dimmed $iceberg.blue bold" # Was blue bold dimmed
disabled = false

[solidity]
format = "via [$symbol($version)]($style)"
version_format = "v${major}.${minor}.${patch}"
disabled = false
style = "bold $iceberg.blue" # Was bold blue
symbol = "S "
compiler = ["solc"]
detect_extensions = ["sol"]
detect_files = []
detect_folders = []

[spack]
truncation_length = 1
format = "via [$symbol$environment]($style) "
symbol = "🅢 "
style = "bold $iceberg.blue" # Was blue bold
disabled = false

[status]
format = "[$symbol$status]($style) "
symbol = "❌"
success_symbol = "" # If you want a success symbol, you can add it here with an Iceberg color
not_executable_symbol = "🚫"
not_found_symbol = "🔍"
sigint_symbol = "🧱"
signal_symbol = "⚡"
style = "bold $iceberg.red" # Was bold red
map_symbol = false
recognize_signal_code = true
pipestatus = false
pipestatus_separator = "|"
pipestatus_format = '\[$pipestatus\] => [$symbol$common_meaning$signal_name$maybe_int]($style)'
disabled = true

[sudo]
format = "[as $symbol]($style)"
symbol = "🧙 "
style = "bold $iceberg.blue" # Was bold blue
allow_windows = false
disabled = true

[swift]
format = "via [$symbol($version )]($style)"
version_format = "v${raw}"
symbol = "🐦 "
style = "bold $iceberg.orange" # Was bold 202 (orange-pink)
disabled = false
detect_extensions = ["swift"]
detect_files = ["Package.swift"]
detect_folders = []

[terraform]
format = "via [$symbol$workspace]($style) "
version_format = "v${raw}"
symbol = "💠 "
style = "bold $iceberg.magenta" # Was bold 105 (magenta)
disabled = false
detect_extensions = ["tf", "tfplan", "tfstate"]
detect_files = []
detect_folders = [".terraform"]

[time]
format = "at [$time]($style) "
style = "bold $iceberg.yellow" # Was bold yellow
use_12hr = false
disabled = true
utc_time_offset = "local"
time_range = "-"

[typst]
format = "via [$symbol($version )]($style)"
version_format = "v${raw}"
symbol = "t "
style = "bold $iceberg.cyan" # Was bold #0093A7 (dark cyan)
disabled = false
detect_extensions = ["typ"]
detect_files = ["template.typ"]
detect_folders = []

[username]
detect_env_vars = []
format = "[$user]($style) in "
style_root = "bold $iceberg.red" # Was red bold
style_user = "bold $iceberg.yellow" # Was yellow bold
show_always = false
disabled = false
aliases = { "Administrator" = "aw5qm" }


[vagrant]
format = "via [$symbol($version )]($style)"
version_format = "v${raw}"
symbol = "⍱ "
style = "bold $iceberg.cyan" # Was cyan bold
disabled = false
detect_extensions = []
detect_files = ["Vagrantfile"]
detect_folders = []

[vcsh]
symbol = ""
style = "bold $iceberg.yellow" # Was bold yellow
format = "vcsh [$symbol$repo]($style) "
disabled = false

[vlang]
format = "via [$symbol($version )]($style)"
version_format = "v${raw}"
symbol = "V "
style = "bold $iceberg.blue" # Was blue bold
disabled = false
detect_extensions = ["v"]
detect_files = ["v.mod", "vpkg.json", ".vpkg-lock.json"]
detect_folders = []

[zig]
format = "via [$symbol($version )]($style)"
version_format = "v${raw}"
symbol = "↯ "
style = "bold $iceberg.yellow" # Was bold yellow
disabled = false
detect_extensions = ["zig"]
detect_files = []
detect_folders = []

[custom]
# Your custom modules would go here, if any.
