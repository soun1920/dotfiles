# 競プロ用
nd() {
    local current_dir=$(basename "$PWD")
    local next_dir=""
    
    case "$current_dir" in
        "a") next_dir="b" ;;
        "b") next_dir="c" ;;
        "c") next_dir="d" ;;
        "d") next_dir="e" ;;
        "e") next_dir="f" ;;
        "f") next_dir="g" ;;
        "g") next_dir="a" ;;
        *) next_dir="" ;;
    esac
    
    if [[ -z "$next_dir" ]]; then
        echo "エラー: 現在のディレクトリは対象外です"
        echo "対象: a b c d e f g"
        return 1
    fi
    
    cd "../$next_dir" && echo "$current_dir → $next_dir"
}

cpp_test() {
    local cpp_file="${1:-main.cpp}"
    zsh -c "g++ -std=gnu++20 -O2 -Wall -Wextra main.cpp"
    
    
    # コマンドを実行して結果を取得
    local res=$(timeout 5s oj t 2>&1)
    local exit_code=$?
    if [[ $exit_code -eq 124 ]]; then
        echo "timeout"
        return 1
    fi
    
    # 結果を表示
    local result=$(eval "unbuffer oj t" 2>&1)
    echo "$result"
    
    # 成功パターンをチェック（複数のパターンに対応）
    if echo "$res" | grep -E "\[SUCCESS\]|test success|All tests passed" >/dev/null 2>&1; then
        cat "main.cpp" | copy_to_clipboard
        echo "copied to clipboard"
    else
        echo "nanimoshinai"
        return $exit_code
    fi
}

alias ot="cpp_test"


# クリップボードにコピーする関数（OS別対応）
copy_to_clipboard() {
    if command -v pbcopy >/dev/null 2>&1; then
        # macOS
        pbcopy
    elif command -v xclip >/dev/null 2>&1; then
        # Linux (X11)
        xclip -selection clipboard
    elif command -v xsel >/dev/null 2>&1; then
        # Linux (alternative)
        xsel --clipboard --input
    elif command -v clip.exe >/dev/null 2>&1; then
        # Windows (WSL)
        clip.exe
    else
        echo "Warning: クリップボードにコピーできませんでした（対応するコマンドが見つかりません）"
        cat  # 標準出力に表示のみ
        return 1
    fi
}
